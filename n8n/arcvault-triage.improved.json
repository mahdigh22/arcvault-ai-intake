    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are an intake triage assistant for a B2B software company called ArcVault. Analyze one inbound customer request and return a structured classification.\n\nRules:\n- category: choose exactly one of \"Bug Report\", \"Feature Request\", \"Billing Issue\", \"Technical Question\", \"Incident/Outage\". Use \"Incident/Outage\" when a live service is broken/unavailable for the customer (e.g. dashboard down, outage, multiple users affected). Use \"Bug Report\" for a defect affecting a single user or flow. Use \"Technical Question\" for how-to / evaluation / setup questions.\n- priority: \"Low\", \"Medium\", or \"High\" based on business impact and urgency.\n- confidence: a number between 0 and 1 for how certain you are of the category.\n- core_issue: the central problem or request in one clear sentence.\n- identifiers: an array of concrete identifiers quoted from the message. Include account IDs, usernames, email addresses, invoice numbers, error codes, URLs, monetary amounts and named products. Copy each one exactly as written, one per array element, and do not add labels or explanations. Return an empty array only when the message contains none.\n- urgency_signal: a short phrase describing why this is or isn't urgent, grounded in the message.\n- summary: a 2-3 sentence, human-readable summary for the receiving team, actionable without reading the raw message.\nBase every field only on the message content. Do not invent identifiers."
            },
            {
              "content": "=Source: {{ $json.source }}\nMessage: {{ $json.raw_message }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxTokens": 700,
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "triage_result",
              "schema": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"category\",\"priority\",\"confidence\",\"core_issue\",\"identifiers\",\"urgency_signal\",\"summary\"],\"properties\":{\"category\":{\"type\":\"string\",\"enum\":[\"Bug Report\",\"Feature Request\",\"Billing Issue\",\"Technical Question\",\"Incident/Outage\"]},\"priority\":{\"type\":\"string\",\"enum\":[\"Low\",\"Medium\",\"High\"]},\"confidence\":{\"type\":\"number\"},\"core_issue\":{\"type\":\"string\"},\"identifiers\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"urgency_signal\":{\"type\":\"string\"},\"summary\":{\"type\":\"string\"}}}",
              "strict": true
            }
          },
          "temperature": 0.2
        }
      },
      "id": "89a9c129-095f-4204-b930-04d09b3ec4aa",
      "name": "Classify & Enrich",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        840,
        48
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const orig = $('Prepare Input').item.json;\n\n// Unwrap the json_schema output from the Classify node.\nconst rawText = $json.output && $json.output[0] && $json.output[0].content && $json.output[0].content[0]\n  ? $json.output[0].content[0].text\n  : undefined;\n\nlet parsed = rawText;\nif (typeof parsed === 'string') {\n  // Throw rather than swallow: a parse failure must not become a fake \"low confidence\"\n  // record. The node's error output responds with 502 instead of storing junk.\n  parsed = JSON.parse(parsed);\n}\nif (!parsed || typeof parsed !== 'object') {\n  throw new Error('Classifier returned an unexpected shape: ' + JSON.stringify($json).slice(0, 300));\n}\n\nconst category = parsed.category || 'Technical Question';\nconst priority = parsed.priority || 'Medium';\nconst confidence = typeof parsed.confidence === 'number' ? parsed.confidence : 0;\nconst identifiers = Array.isArray(parsed.identifiers)\n  ? parsed.identifiers.map((entry) => String(entry).trim()).filter(Boolean)\n  : [];\nconst rawMessage = orig.raw_message || '';\nconst text = rawMessage.toLowerCase();\n\n// Step 4 - map classification to a destination queue.\nconst queueMap = {\n  'Bug Report': 'Engineering',\n  'Incident/Outage': 'Engineering',\n  'Feature Request': 'Product',\n  'Billing Issue': 'Billing',\n  'Technical Question': 'IT/Security',\n};\nlet routing_queue = queueMap[category] || 'General Triage';\n\n// Step 6 - human escalation criteria. Every rule below is deterministic and\n// evaluated independently of the model's own priority judgement.\nconst reasons = [];\n\nif (confidence < 0.7) reasons.push('Low confidence (<70%)');\n\nif (category === 'Incident/Outage' ||\n    /\\boutage\\b|\\bdown for (all|multiple) users\\b|\\bmultiple users (are )?(affected|impacted)\\b|\\bproduction (is )?down\\b/.test(text)) {\n  reasons.push('Outage / incident signal');\n}\n\n// Explicit critical wording, regardless of the predicted category.\nif (/\\b(urgent|asap|critical|emergency|data loss|security breach|breach|locked out)\\b/.test(text)) {\n  reasons.push('Critical wording in message');\n}\n\n// Billing threshold. The amount scan runs on every message so a misclassification\n// cannot bypass the rule; a billing context check keeps it from firing on stray sums.\nconst amounts = (rawMessage.match(/\\$\\s?[\\d,]+(?:\\.\\d+)?/g) || [])\n  .map((a) => parseFloat(a.replace(/[$,\\s]/g, '')))\n  .filter((n) => !isNaN(n));\nconst maxAmt = amounts.length ? Math.max(...amounts) : 0;\nconst billingContext = category === 'Billing Issue' || /invoice|charge|billed|billing|refund|payment|contract rate/.test(text);\nif (maxAmt > 500 && billingContext) {\n  reasons.push('Billing amount over $500 ($' + maxAmt + ')');\n}\n\nconst escalation_flag = reasons.length > 0;\nif (escalation_flag) routing_queue = 'Human Escalation';\n\nreturn [{\n  json: {\n    source: orig.source || '',\n    raw_message: rawMessage,\n    category,\n    priority,\n    confidence,\n    core_issue: parsed.core_issue || '',\n    // Kept as an array here; the Data Table node joins it for its string column.\n    identifiers,\n    urgency_signal: parsed.urgency_signal || '',\n    routing_queue,\n    escalation_flag,\n    escalation_reason: reasons.join('; '),\n    summary: parsed.summary || '',\n    processed_at: new Date().toISOString(),\n  },\n}];"
      },
