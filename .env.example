# Start with mock mode so the UI works immediately.
USE_MOCK=true

# When your n8n workflow is ready, set USE_MOCK=false and paste its production webhook URL.
N8N_WEBHOOK_URL=https://YOUR-N8N-HOST/webhook/arcvault-triage

# Header Auth credential configured on the n8n webhook node.
# N8N_WEBHOOK_HEADER is the header name (defaults to x-api-key if omitted).
N8N_WEBHOOK_HEADER=x-api-key
N8N_WEBHOOK_SECRET=
